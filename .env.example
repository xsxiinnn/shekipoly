NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required server-side for trusted photo reports and private photo-wall signed URLs.
# Never add NEXT_PUBLIC_ to this key.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local scoring tests only. Add to .env.local, then restart next dev.
# This override is ignored when NODE_ENV=production.
# DEV_ACTIVITY_WEEK=1
