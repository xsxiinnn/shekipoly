NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required server-side for trusted photo reports and private photo-wall signed URLs.
# Never add NEXT_PUBLIC_ to this key.
SUPABASE_SERVICE_ROLE_KEY=

# Local scoring tests only. Add to .env.local, then restart next dev.
# This override is ignored when NODE_ENV=production.
# Only works outside production. Valid local values: 1 through 6.
DEV_ACTIVITY_WEEK=

# Server-controlled public test mode. Never add NEXT_PUBLIC_ to either value.
# Automatically ignored at/after 2026-08-31 00:00 Asia/Taipei.
# Still remove or set false before the formal activity deployment.
PRELAUNCH_TEST_MODE=
PRELAUNCH_TEST_WEEK=
